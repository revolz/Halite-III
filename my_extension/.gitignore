# my_extension — all local ignore rules live here (one file, consistent across bots)

# Python bytecode
__pycache__/
*.py[cod]

# Bot subprocess logs
bot-*.log

# Training artifacts — each bot publishes its single strongest checkpoint
# as checkpoints/best.pt; everything else stays local
checkpoints_*/
**/checkpoints/*.pt
!**/checkpoints/best.pt
dataset/
dataset_*/
replays_*/
